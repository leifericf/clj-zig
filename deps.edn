{:paths ["src"]
 :deps {org.clojure/data.json {:mvn/version "2.5.0"}}

 :aliases
 ;; Finalized FFM (Java 22+): the flag opens native access explicitly;
 ;; --enable-preview is not needed. Development runs on JDK 26.
 {:repl
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; The :test lane includes bench/ on its classpath so the pure-core
  ;; perf unit tests (test/clj_zig/perf/*_test.clj requiring
  ;; clj-zig.perf.shape and clj-zig.perf.stats) run in the green gate.
  ;; bench/ is the pure core only at this point; the bench shell
  ;; clj-zig.perf.run (landed later) requires Criterium, which is NOT a
  ;; :test dependency -- the load-bearing assertion is that :test never
  ;; requires clj-zig.perf.run once it exists.
  :test
  {:extra-paths ["test" "bench"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                org.clojars.czan/stateful-check {:mvn/version "0.4.4"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; The perf lane. ADDITIVE over :test: it adds Criterium (NOT a :test
  ;; dependency) and points main-opts at the imperative bench shell
  ;; clj-zig.perf.run, the ONLY namespace that requires Criterium. The
  ;; lane compiles real Zig and writes numbers to gitignored
  ;; ~/.agentic-sdk/clj-zig/artifacts/perf/; it is tracking, never a
  ;; gate, so it stays out of the project's :lanes. Native access is
  ;; required: every JVM that loads a clj-zig library needs the flag.
  :bench
  {:extra-paths ["bench"]
   :extra-deps {criterium/criterium {:mvn/version "0.4.6"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "clj-zig.perf.run"]}

  ;; Release build. Packages and publishes clj-zig to Clojars; `deploy`
  ;; is run by the maintainer with Clojars credentials. The git-dep path
  ;; stays available for contributors regardless of a published release.
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}}
   :ns-default build}

  ;; Pure-core coverage gate. Instruments the functional core only; the
  ;; imperative shell (compile, ffm, core, inspect, diagnostics) is the
  ;; named allowlist, covered by the native and lifecycle suites but not
  ;; floored here. Run with `clojure -M:coverage`.
  :coverage
  {:extra-paths ["test"]
   :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                org.clojars.czan/stateful-check {:mvn/version "0.4.4"}}
   :main-opts ["-m" "cloverage.coverage"
               "-p" "src" "-s" "test"
               "--ns-regex" "clj-zig\\.(signature|type|spec|source|layout|cache)"
               "--text" "--no-html"
               "--fail-threshold" "90"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}
